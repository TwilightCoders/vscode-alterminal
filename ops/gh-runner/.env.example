# Copy to .env (which is gitignored) and fill in ONE of the two tokens.
#
# Option A — registration token (quick bootstrap; survives `restart` but NOT a
# container recreate, since it's single-use and short-lived ~1h):
#   gh api -X POST repos/TwilightCoders/vscode-alterminal/actions/runners/registration-token --jq .token
RUNNER_TOKEN=

# Option B — fine-grained PAT (preferred for permanence; the runner re-registers
# itself, so it survives `docker compose down && up`). Scope it to ONLY the
# vscode-alterminal repo with Administration: Read and write. Then comment out
# RUNNER_TOKEN above and set:
# ACCESS_TOKEN=
