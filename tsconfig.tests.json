{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "out/test",
    "module": "CommonJS",
    "types": ["mocha", "node", "vscode"],
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "test/**/*",
    "src/providers/tabTitleProvider.ts",
    "src/utils/logger.ts",
    "src/utils/commandManager.ts",
    "src/utils/templateEngine.ts",
    "src/constants.ts"
  ],
  "exclude": ["node_modules", ".vscode-test", "vendor"]
}
