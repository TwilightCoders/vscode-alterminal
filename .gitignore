# VS Code Extension
out/
out-webview/
node_modules/
*.vsix
.vscode-test/
build/
# Local dev builds drop bin/loomptyd here (scripts/build-daemon.sh). The
# platform-named binaries are vendored/committed so CI can ship them.
bin/*
!bin/loomptyd-darwin-arm64
!bin/loomptyd-darwin-x64
!bin/loomptyd-linux-x64
!bin/loomptyd-linux-arm64

# TypeScript
*.js.map
*.d.ts
!src/**/*.d.ts

# Logs
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp

# Working directory and backups
working/
vendor/
scrap/
.Codex/
buffer-with-snap.txt

# Dev build counter and generated files
.vscode/dev-counter
src/generated/

# ClaudePilot session scratch (agent harness, not project state)
.claudepilot/
